{% extends 'base_feed.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main class="f-wrap">
        <header class="f-clock">
            <div class="f-clock-time">🔔</div>
            <div class="f-clock-date">on t'attendait</div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="f-flash f-flash-ok" role="status">{{ message }}</div>
        {% endfor %}

        {% if error %}
            <div class="f-flash" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" class="f-card">
            <h1 class="f-card-title">Connexion</h1>

            <div class="f-field">
                <label for="username" class="f-label">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}"
                       class="f-input" autocomplete="email" required autofocus>
            </div>

            <div class="f-field" data-controller="password-visibility">
                <label for="password" class="f-label">Mot de passe</label>
                <div class="f-input-group">
                    <input type="password" id="password" name="_password"
                           class="f-input" autocomplete="current-password" required
                           data-password-visibility-target="input">
                    <button type="button" class="f-eye"
                            data-action="password-visibility#toggle"
                            data-password-visibility-target="button"
                            aria-label="Afficher le mot de passe"
                            aria-pressed="false"
                            tabindex="-1">
                        <span data-password-visibility-target="icon" data-show="👁" data-hide="🙈" aria-hidden="true">👁</span>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="f-submit">Se connecter</button>
        </form>
    </main>
{% endblock %}
