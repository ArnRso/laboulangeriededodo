{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-4">Connexion</h1>

            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">Email</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}"
                           class="form-control" autocomplete="email" required autofocus>
                </div>

                <div class="mb-3" data-controller="password-visibility">
                    <label for="password" class="form-label">Mot de passe</label>

                    <div class="input-group">
                        <input type="password" id="password" name="_password"
                               class="form-control" autocomplete="current-password" required
                               data-password-visibility-target="input">

                        <button type="button" class="btn btn-outline-secondary"
                                data-action="password-visibility#toggle"
                                data-password-visibility-target="button"
                                aria-label="Afficher le mot de passe"
                                aria-pressed="false"
                                tabindex="-1">
                            <i class="bi bi-eye" data-password-visibility-target="icon" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primary w-100">Se connecter</button>
            </form>
        </div>
    </div>
{% endblock %}
