{% extends 'admin/_layout.html.twig' %}

{% block title %}Modifier {{ media.title }}{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-1">Modifier le média</h1>
    <p class="text-body-secondary mb-4">Pack : {{ media.pack.name }}</p>

    <div class="row">
        <div class="col-12 col-lg-7">
            {% if media.filePath %}
                <div class="alert alert-secondary">
                    Fichier actuel : <a href="{{ path('app_media_file', {id: media.id}) }}" target="_blank">{{ media.originalName ?? media.filePath }}</a>
                </div>
            {% endif %}

            {{ include('admin/media/_form.html.twig', {
                submitLabel: 'Enregistrer',
                cancelPath: path('app_admin_pack_show', {id: media.pack.id}),
            }) }}
        </div>
    </div>
{% endblock %}
