{% extends 'admin/_layout.html.twig' %}

{% block title %}Ajouter un média{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-1">Ajouter un média</h1>
    <p class="text-body-secondary mb-4">Pack : {{ pack.name }}</p>

    <div class="row">
        <div class="col-12 col-lg-7">
            {{ include('admin/media/_form.html.twig', {
                submitLabel: 'Ajouter',
                cancelPath: path('app_admin_pack_show', {id: pack.id}),
            }) }}
        </div>
    </div>
{% endblock %}
