{% extends 'admin/_layout.html.twig' %}

{% block title %}Modifier {{ pack.name }}{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-4">Modifier le pack</h1>

    <div class="row">
        <div class="col-12 col-lg-6">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {{ form_row(form.unlockDelayHours) }}
                {{ form_row(form.published) }}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_admin_pack_show', {id: pack.id}) }}">Annuler</a>
                </div>
            {{ form_end(form) }}

            <hr class="my-4">

            <form method="post" action="{{ path('app_admin_pack_delete', {id: pack.id}) }}"
                  onsubmit="return confirm('Supprimer ce pack et tous ses médias ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_pack_' ~ pack.id) }}">
                <button type="submit" class="btn btn-outline-danger">Supprimer ce pack</button>
            </form>
        </div>
    </div>
{% endblock %}
