{% extends 'admin/_layout.html.twig' %}

{% block title %}Nouveau pack{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-4">Nouveau pack</h1>

    <div class="row">
        <div class="col-12 col-lg-6">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                <div class="mb-3">
                    <span class="form-label d-block">Délai entre deux médias</span>
                    <div class="row g-2">
                        <div class="col-6">{{ form_row(form.unlockDelayMinutes.hours) }}</div>
                        <div class="col-6">{{ form_row(form.unlockDelayMinutes.minutes) }}</div>
                    </div>
                    {{ form_errors(form.unlockDelayMinutes) }}
                </div>
                {{ form_row(form.published) }}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Créer</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_admin_pack_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
