{% extends 'admin/_layout.html.twig' %}

{% block title %}Nouveau pack{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-4">Nouveau pack</h1>

    <div class="row">
        <div class="col-12 col-lg-6">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {{ form_row(form.unlockDelayHours) }}
                {{ form_row(form.published) }}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Créer</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_admin_pack_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
