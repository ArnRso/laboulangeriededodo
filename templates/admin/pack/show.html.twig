{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ pack.name }}{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">{{ pack.name }}</h1>
            <p class="text-body-secondary mb-0">
                Un média toutes les {{ pack.delayLabel }} ·
                {% if pack.published %}visible{% else %}masqué{% endif %}
            </p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_pack_edit', {id: pack.id}) }}">Modifier</a>
            <a class="btn btn-primary" href="{{ path('app_admin_media_new', {id: pack.id}) }}">Ajouter un média</a>
        </div>
    </div>

    {% if pack.description %}
        <p>{{ pack.description }}</p>
    {% endif %}

    {% if medias is empty %}
        <div class="alert alert-info">
            Ce pack ne contient aucun média. Il ne sera pas proposé tant qu'il sera vide.
        </div>
    {% else %}
        <ol class="list-group list-group-numbered">
            {% for media in medias %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <div class="flex-grow-1">
                        <div class="fw-semibold">{{ media.title }}</div>
                        <small class="text-body-secondary">{{ media.type.label }}</small>
                    </div>

                    <div class="d-flex gap-1">
                        <form method="post" action="{{ path('app_admin_media_move', {id: media.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('move_media_' ~ media.id) }}">
                            <input type="hidden" name="direction" value="up">
                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                    {{ loop.first ? 'disabled' : '' }} aria-label="Monter">↑</button>
                        </form>

                        <form method="post" action="{{ path('app_admin_media_move', {id: media.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('move_media_' ~ media.id) }}">
                            <input type="hidden" name="direction" value="down">
                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                    {{ loop.last ? 'disabled' : '' }} aria-label="Descendre">↓</button>
                        </form>

                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_media_edit', {id: media.id}) }}">Modifier</a>

                        <form method="post" action="{{ path('app_admin_media_delete', {id: media.id}) }}"
                              onsubmit="return confirm('Supprimer ce média ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endblock %}
