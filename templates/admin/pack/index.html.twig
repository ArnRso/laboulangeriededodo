{% extends 'admin/_layout.html.twig' %}

{% block title %}Packs{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Packs</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_pack_new') }}">Nouveau pack</a>
    </div>

    {% if packs is empty %}
        <div class="alert alert-info">Aucun pack pour le moment.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th class="text-center">Médias</th>
                        <th class="text-center">Délai</th>
                        <th class="text-center">Visible</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for pack in packs %}
                        <tr>
                            <td>
                                <a href="{{ path('app_admin_pack_show', {id: pack.id}) }}">{{ pack.name }}</a>
                            </td>
                            <td class="text-center">{{ pack.mediaCount }}</td>
                            <td class="text-center">{{ pack.delayLabel }}</td>
                            <td class="text-center">
                                {% if pack.published %}
                                    <span class="badge text-bg-success">Oui</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Non</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_pack_edit', {id: pack.id}) }}">Modifier</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
