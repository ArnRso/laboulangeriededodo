{% extends 'admin/_layout.html.twig' %}

{% block title %}Modifier {{ media.title }}{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            {% if media.appKind %}
                <h1 class="h3 mb-1 d-flex align-items-center gap-2">{{ include('admin/_app_icon.html.twig', {app: media.appKind, size: 30}, with_context: false) }} Modifier la notification</h1>
                <p class="text-body-secondary mb-0">
                    {{ media.appKind.label }} ·
                    {% if canDress %}
                        tu peux la faire passer par une autre application, ses textes suivront.
                    {% else %}
                        Dorian l'a déjà ouverte, elle ne change plus d'application.
                    {% endif %}
                </p>
            {% else %}
                <h1 class="h3 mb-1">📝 Modifier le brouillon</h1>
                <p class="text-body-secondary mb-0">Sans application pour l'instant : remplis ce que tu as, puis choisis l'application qui le fera passer.</p>
            {% endif %}
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            {% if media.appKind %}
                {% if canDress %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_admin_notification_dress_choose', {id: media.id}) }}">Changer d'application</a>
                {% endif %}
                <a class="btn btn-outline-primary" href="{{ path('app_admin_notification_preview', {id: media.id}) }}">Aperçu plein écran</a>
            {% else %}
                <a class="btn btn-primary" href="{{ path('app_admin_notification_dress_choose', {id: media.id}) }}">Choisir l'application</a>
            {% endif %}
        </div>
    </div>

    {% set currentFile %}
        {% if media.filePath %}
            <div class="alert alert-secondary">
                Fichier actuel : <a href="{{ path('app_media_file', {id: media.id}) }}" target="_blank">{{ media.originalName ?? media.filePath }}</a>
            </div>
        {% endif %}
    {% endset %}

    {% if media.appKind %}
        <div class="row g-4"
             data-controller="live-preview"
             data-live-preview-url-value="{{ path('app_admin_notification_preview', {id: media.id}) }}"
             data-action="input->live-preview#refresh change->live-preview#refresh media-type:changed->live-preview#refresh">
            <div class="col-12 col-lg-7">
                {{ currentFile }}

                {{ include('admin/notification/_form.html.twig', {
                    form: form,
                    appKind: media.appKind,
                    submitLabel: 'Enregistrer',
                    cancelPath: path('app_admin_notification_index'),
                }, with_context: false) }}
            </div>
            <div class="col-12 col-lg-5">
                {{ include('admin/notification/_live_preview.html.twig') }}
            </div>
        </div>
    {% else %}
        {# Pas d'écran à prévisualiser tant que l'application n'est pas choisie. #}
        <div class="row">
            <div class="col-12 col-lg-8">
                {{ currentFile }}

                {{ include('admin/notification/_form.html.twig', {
                    form: form,
                    appKind: null,
                    submitLabel: 'Enregistrer le brouillon',
                    cancelPath: path('app_admin_notification_index'),
                }, with_context: false) }}
            </div>
        </div>
    {% endif %}
{% endblock %}
