{% extends 'admin/_layout.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Le fil</h1>
            <p class="text-body-secondary mb-0 small">Dans l'ordre où Dorian les recevra. Chaque délai court à partir de l'ouverture de la précédente.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_admin_notification_choose') }}">Nouvelle notification</a>
    </div>

    {% if tags is not empty %}
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="text-body-secondary small">Étiquettes :</span>
            <a class="btn btn-sm {{ activeTag ? 'btn-outline-secondary' : 'btn-secondary' }}"
               href="{{ path('app_admin_notification_index') }}">Toutes</a>
            {% for tag in tags %}
                <a class="btn btn-sm {{ activeTag == tag ? 'btn-secondary' : 'btn-outline-secondary' }}"
                   href="{{ path('app_admin_notification_index', {tag: tag.id}) }}">{{ tag.name }}</a>
            {% endfor %}
            <a class="btn btn-sm btn-link" href="{{ path('app_admin_tag_index') }}">Gérer</a>
        </div>
    {% endif %}

    {% if medias is empty %}
        {% if activeTag %}
            <div class="alert alert-info">Aucune notification avec l'étiquette « {{ activeTag.name }} ».</div>
        {% else %}
            <div class="alert alert-info">Le fil est vide. Ajoute une première notification : elle sera disponible dès l'activation du compte.</div>
        {% endif %}
    {% else %}
        {# Le glisser-déposer n'est possible que sur le fil entier : filtré par
           étiquette, l'ordre envoyé serait incomplet. #}
        {% set sortable = not activeTag %}

        <ol class="list-group list-group-numbered"
            {% if sortable %}
                data-controller="sortable"
                data-sortable-url-value="{{ path('app_admin_notification_reorder') }}"
                data-sortable-token-value="{{ csrf_token('reorder_medias') }}"
            {% endif %}>
            {% for media in medias %}
                <li class="list-group-item d-flex justify-content-between align-items-center gap-3{{ media.published ? '' : ' list-group-item-light' }}"
                    {% if sortable %}
                        data-sortable-target="item"
                        data-sortable-id="{{ media.id }}"
                        data-action="dragover->sortable#over"
                    {% endif %}>
                    <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                        {% if sortable %}
                            <span class="a-grip" draggable="true" title="Glisser pour réordonner"
                                  data-action="dragstart->sortable#start dragend->sortable#end">⠿</span>
                        {% endif %}
                        {% if media.appKind %}
                            {{ include('admin/_app_icon.html.twig', {app: media.appKind, size: 28}, with_context: false) }}
                        {% else %}
                            <span class="fs-4" title="Brouillon sans application">📝</span>
                        {% endif %}
                        <div class="min-w-0">
                            <div class="fw-semibold text-truncate">
                                {{ media.title }}
                                {% if not media.appKind %}<span class="badge text-bg-warning ms-1">Sans application</span>{% endif %}
                            </div>
                            <small class="text-body-secondary">
                                {{ media.appKind ? media.appKind.label : 'À habiller' }} · {{ media.type.label }} ·
                                {% if loop.first %}immédiate{% else %}{{ media.delayLabel }} après la précédente{% endif %}
                            </small>
                            {% if media.tags is not empty %}
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    {% for tag in media.tags %}
                                        <a class="badge text-bg-light text-decoration-none"
                                           href="{{ path('app_admin_notification_index', {tag: tag.id}) }}">{{ tag.name }}</a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        {# Dans le fil ou pas : l'interrupteur se soumet au
                           changement. Un brouillon n'a rien à y faire. #}
                        {% set etat = media.appKind
                            ? (media.published ? 'Dans le fil — cliquer pour la retirer' : 'Hors du fil — cliquer pour l\'y mettre')
                            : 'Un brouillon ne peut pas entrer dans le fil' %}
                        <form method="post" action="{{ path('app_admin_notification_toggle', {id: media.id}) }}"
                              title="{{ etat }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_media_' ~ media.id) }}">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox"
                                       id="fil-{{ media.id }}"
                                       aria-label="{{ etat }}"
                                       {{ media.published ? 'checked' : '' }}
                                       {{ media.appKind ? '' : 'disabled' }}
                                       onchange="this.form.requestSubmit()">
                            </div>
                        </form>

                        <div class="d-flex gap-1">
                            <form method="post" action="{{ path('app_admin_notification_move', {id: media.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('move_media_' ~ media.id) }}">
                                <input type="hidden" name="direction" value="up">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" {{ loop.first ? 'disabled' : '' }} aria-label="Monter">↑</button>
                            </form>
                            <form method="post" action="{{ path('app_admin_notification_move', {id: media.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('move_media_' ~ media.id) }}">
                                <input type="hidden" name="direction" value="down">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" {{ loop.last ? 'disabled' : '' }} aria-label="Descendre">↓</button>
                            </form>
                            {% if media.appKind %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_notification_preview', {id: media.id}) }}">Aperçu</a>
                            {% else %}
                                <a class="btn btn-sm btn-primary" href="{{ path('app_admin_notification_dress_choose', {id: media.id}) }}">Habiller</a>
                            {% endif %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_notification_edit', {id: media.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_admin_notification_delete', {id: media.id}) }}"
                                  onsubmit="return confirm('Supprimer cette notification ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endblock %}
