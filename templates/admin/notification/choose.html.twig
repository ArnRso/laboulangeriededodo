{% extends 'admin/_layout.html.twig' %}

{% block title %}Nouvelle notification{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-1">Nouvelle notification</h1>
    <p class="text-body-secondary mb-4">Étape 1 sur 2 — quelle application va la faire passer ?</p>

    <div class="row g-3">
        {% for appKind in appKinds %}
            <div class="col-12 col-md-6">
                <a class="card h-100 text-decoration-none text-body" href="{{ path('app_admin_notification_new', {app: appKind.value}) }}">
                    <div class="card-body d-flex gap-3">
                        <span class="fs-1">{{ appKind.icon }}</span>
                        <div>
                            <h2 class="h5 card-title mb-1">{{ appKind.label }}</h2>
                            <p class="card-text text-body-secondary small mb-0">{{ appKind.pitch }}</p>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    <a class="btn btn-outline-secondary mt-4" href="{{ path('app_admin_notification_index') }}">Annuler</a>
{% endblock %}
