{{ form_start(form, {attr: {'data-live-preview-target': 'form'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}

    <div class="mb-3" data-controller="media-type">
        <span class="form-label d-block">Contenu du souvenir</span>

        <ul class="nav nav-tabs mb-3" role="tablist">
            {% for choice in form.type.vars.choices %}
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link"
                            role="tab"
                            aria-selected="false"
                            data-media-type-target="tab"
                            data-media-type-value="{{ choice.value }}"
                            data-media-type-accept="{{ choice.data.acceptAttribute ?? '' }}"
                            data-action="media-type#choose">
                        <i class="bi bi-{{ choice.data.icon }} me-1" aria-hidden="true"></i>
                        {{ choice.data.label }}
                    </button>
                </li>
            {% endfor %}
        </ul>

        <div class="d-none">{{ form_widget(form.type) }}</div>

        {# Photo, vidéo et audio partagent le même champ : seul l'attribut
           accept change, ajusté par le contrôleur selon l'onglet actif. #}
        <div class="d-none" data-media-type-target="panel" data-media-type-panel="file">
            {{ form_row(form.file, {attr: {'data-action': 'change->live-preview#pickFile'}}) }}
        </div>

        <div class="d-none" data-media-type-target="panel" data-media-type-panel="text">
            {{ form_row(form.textContent) }}
        </div>

        <div class="d-none" data-media-type-target="panel" data-media-type-panel="link">
            {{ form_row(form.url) }}
        </div>
    </div>

    {{ include('admin/notification/_fragments.html.twig', {collection: form.fragments}, with_context: false) }}

    {{ form_row(form.tags, {attr: {list: 'known-tags'}}) }}
    {# Les étiquettes déjà posées ailleurs, pour éviter d'en inventer une
       variante à chaque saisie. #}
    <datalist id="known-tags">
        {% for tag in knownTags %}<option value="{{ tag }}"></option>{% endfor %}
    </datalist>

    {# Un brouillon n'a pas encore d'application, donc pas de détails. #}
    {% if form.appData is defined %}
        <fieldset class="border rounded p-3 mb-3">
            <legend class="fs-6 fw-semibold mb-2">{{ appKind.icon }} Détails {{ appKind.label }}</legend>
            {% for child in form.appData %}
                {{ form_row(child) }}
            {% endfor %}
        </fieldset>
    {% endif %}

    <fieldset class="border rounded p-3 mb-3">
        <legend class="fs-6 fw-semibold mb-2">Arrivée</legend>
        <div class="mb-3">
            <span class="form-label d-block">Délai d'arrivée</span>
            <div class="row g-2">
                <div class="col-6">{{ form_row(form.delayMinutes.hours) }}</div>
                <div class="col-6">{{ form_row(form.delayMinutes.minutes) }}</div>
            </div>
            {{ form_errors(form.delayMinutes) }}
            {{ form_help(form.delayMinutes) }}
        </div>
        {% if form.published is defined %}
            {{ form_row(form.published) }}
        {% endif %}
    </fieldset>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">{{ submitLabel }}</button>
        <a class="btn btn-outline-secondary" href="{{ cancelPath }}">Annuler</a>
    </div>
{{ form_end(form) }}
