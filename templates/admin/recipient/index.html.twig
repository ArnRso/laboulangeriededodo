{% extends 'admin/_layout.html.twig' %}

{% block title %}Destinataires{% endblock %}

{% block admin_body %}
    {% if invitationLink %}
        <div class="alert alert-success" role="status">
            <div class="fw-semibold mb-1">Le lien de {{ invitationLink.name }} est prêt</div>
            <p class="small mb-2">Valable {{ invitationLink.lifetime }}. À toi de le transmettre : il n'a été envoyé à personne.</p>
            <div class="input-group" data-controller="copy">
                <input type="text" class="form-control font-monospace" value="{{ invitationLink.url }}"
                       readonly data-copy-target="source" onfocus="this.select()">
                <button type="button" class="btn btn-outline-secondary"
                        data-action="copy#toClipboard" data-copy-target="button">Copier</button>
            </div>
        </div>
    {% endif %}

    <h1 class="h3 mb-1">Destinataires</h1>
    <p class="text-body-secondary mb-4">Tout le monde reçoit le même fil, chacun à son rythme : les délais courent à partir de ses propres ouvertures.</p>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            {% if recipients is empty %}
                <p class="text-body-secondary">Personne pour l'instant. Invite quelqu'un avec le formulaire.</p>
            {% else %}
                <ul class="list-group">
                    {% for row in recipients %}
                        <li class="list-group-item d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-3 min-w-0">
                                <span class="fs-3">{{ row.user.avatar ? row.user.avatar.value : '🙂' }}</span>
                                <div class="min-w-0">
                                    <div class="fw-semibold text-truncate">
                                        {{ row.user.publicName }}
                                        {% if not row.user.password %}
                                            {% if row.hasPendingInvitation %}
                                                <span class="badge text-bg-warning ms-1">Invitation en attente</span>
                                            {% else %}
                                                <span class="badge text-bg-danger ms-1">Invitation expirée</span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                    <small class="text-body-secondary text-truncate d-block">
                                        {{ row.user.email }} ·
                                        {% if row.user.password %}
                                            {{ row.opened }} / {{ feedLength }} ouverte{{ row.opened > 1 ? 's' : '' }}
                                        {% else %}
                                            compte pas encore activé
                                        {% endif %}
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-1">
                                {% if row.user.password %}
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="{{ path('app_feed', {_switch_user: row.user.email}) }}">Voir son fil</a>
                                {% else %}
                                    {# Le compte attend son mot de passe : on peut relancer, par
                                       mail ou par un lien qu'on transmet soi-même. #}
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#invitation-{{ row.user.id }}">Relancer l'invitation</button>
                                {% endif %}

                                {% if row.opened > 0 %}
                                    <form method="post" action="{{ path('app_admin_recipient_reset', {id: row.user.id}) }}"
                                          onsubmit="return confirm('Remettre {{ row.user.publicName }} au début du fil ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reset_recipient_' ~ row.user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remettre au début</button>
                                    </form>
                                {% endif %}

                                <form method="post" action="{{ path('app_admin_recipient_delete', {id: row.user.id}) }}"
                                      onsubmit="return confirm('Supprimer {{ row.user.publicName }} ? Son compte et sa progression disparaissent.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_recipient_' ~ row.user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>

                            {% if not row.user.password %}
                                <div class="modal fade" id="invitation-{{ row.user.id }}" tabindex="-1"
                                     aria-labelledby="invitation-{{ row.user.id }}-titre" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="invitation-{{ row.user.id }}-titre">Relancer {{ row.user.publicName }}</h2>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="text-body-secondary small">{{ row.user.email }} n'a pas encore choisi son mot de passe. Les deux options remplacent le lien précédent.</p>

                                                <form method="post" action="{{ path('app_admin_recipient_resend', {id: row.user.id}) }}" class="mb-4">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('resend_recipient_' ~ row.user.id) }}">
                                                    <button type="submit" class="btn btn-primary w-100">Envoyer l'invitation par email</button>
                                                    <p class="form-text mt-1 mb-0">Valable une semaine.</p>
                                                </form>

                                                <hr>

                                                <form method="post" action="{{ path('app_admin_recipient_link', {id: row.user.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('link_recipient_' ~ row.user.id) }}">
                                                    <label class="form-label" for="lifetime-{{ row.user.id }}">Validité du lien</label>
                                                    <select name="lifetime" id="lifetime-{{ row.user.id }}" class="form-select mb-2">
                                                        {% for lifetime in lifetimes %}
                                                            <option value="{{ lifetime.value }}"{{ lifetime.value == 10080 ? ' selected' : '' }}>{{ lifetime.label }}</option>
                                                        {% endfor %}
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-primary w-100">Me donner le lien, je l'envoie moi-même</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="col-12 col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 card-title mb-3">Inviter quelqu'un</h2>
                    <p class="form-text mt-0 mb-3">Une adresse déjà invitée mais pas encore activée reçoit un lien neuf, et son prénom ou son avatar sont mis à jour.</p>

                    {{ form_start(form) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.displayName) }}

                        <div class="mb-3">
                            {{ form_label(form.avatar) }}
                            {# Le radio est écrit à la main : le thème Bootstrap
                               l'envelopperait dans un form-check avec son propre
                               label, qui doublerait le nom et casserait la grille. #}
                            <div class="avatar-grid">
                                {% for choice in form.avatar %}
                                    <input type="radio"
                                           class="visually-hidden"
                                           id="{{ choice.vars.id }}"
                                           name="{{ choice.vars.full_name }}"
                                           value="{{ choice.vars.value }}"
                                           {{ choice.vars.checked ? 'checked' : '' }}>
                                    <label class="avatar-choice" for="{{ choice.vars.id }}">
                                        <span class="avatar-choice-emoji" aria-hidden="true">{{ choice.vars.value }}</span>
                                        <span class="avatar-choice-name">{{ choice.vars.label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.avatar) }}

                            {# Les radios sont écrits à la main plus haut : sans
                               ce passage, form_end() les rendrait une seconde
                               fois, en liste, sous le bouton d'envoi. #}
                            {% do form.avatar.setRendered %}
                        </div>

                        {{ form_row(form.sendEmail) }}
                        {{ form_row(form.lifetime) }}

                        <button type="submit" class="btn btn-primary mt-2">Inviter</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
