{% extends 'admin/_layout.html.twig' %}

{% block title %}Destinataire{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-4">Destinataire</h1>

    <div class="row">
        <div class="col-12 col-lg-6">
            {% if recipient %}
                <div class="alert {{ recipient.password ? 'alert-success' : 'alert-warning' }}">
                    {% if recipient.password %}
                        {{ recipient.avatar ? recipient.avatar.value ~ ' ' : '' }}<strong>{{ recipient.publicName }}</strong>
                        ({{ recipient.email }}) a activé son compte.
                    {% elseif hasPendingInvitation %}
                        Une invitation est en attente pour <strong>{{ recipient.email }}</strong>.
                        Vous pouvez la renvoyer ci-dessous.
                    {% else %}
                        L'invitation de <strong>{{ recipient.email }}</strong> a expiré.
                        Renvoyez-la pour lui donner un nouveau lien.
                    {% endif %}
                </div>
            {% else %}
                <p class="text-body-secondary">
                    Aucun destinataire pour le moment. Saisissez son adresse pour lui envoyer l'invitation.
                </p>
            {% endif %}

            {% if not recipient or not recipient.password %}
                {{ form_start(form) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.displayName) }}

                    <div class="mb-3">
                        {{ form_label(form.avatar) }}
                        <div class="d-flex flex-wrap gap-2">
                            {% for choice in form.avatar %}
                                <label class="btn btn-outline-secondary fs-4 px-3" for="{{ choice.vars.id }}" title="{{ choice.vars.label|split('  ')|last }}">
                                    {{ form_widget(choice, {attr: {class: 'visually-hidden'}}) }}
                                    {{ choice.vars.label|split('  ')|first }}
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.avatar) }}
                    </div>

                    <button type="submit" class="btn btn-primary mt-2">
                        {{ recipient ? 'Renvoyer l\'invitation' : 'Envoyer l\'invitation' }}
                    </button>
                {{ form_end(form) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
