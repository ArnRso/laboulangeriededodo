{% extends 'admin/_layout.html.twig' %}

{% block title %}Destinataires{% endblock %}

{% block admin_body %}
    <h1 class="h3 mb-1">Destinataires</h1>
    <p class="text-body-secondary mb-4">Tout le monde reçoit le même fil, chacun à son rythme : les délais courent à partir de ses propres ouvertures.</p>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            {% if recipients is empty %}
                <p class="text-body-secondary">Personne pour l'instant. Invite quelqu'un avec le formulaire.</p>
            {% else %}
                <ul class="list-group">
                    {% for row in recipients %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-center gap-3 min-w-0">
                                <span class="fs-3">{{ row.user.avatar ? row.user.avatar.value : '🙂' }}</span>
                                <div class="min-w-0">
                                    <div class="fw-semibold text-truncate">
                                        {{ row.user.publicName }}
                                        {% if not row.user.password %}
                                            {% if row.hasPendingInvitation %}
                                                <span class="badge text-bg-warning ms-1">Invitation en attente</span>
                                            {% else %}
                                                <span class="badge text-bg-danger ms-1">Invitation expirée</span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                    <small class="text-body-secondary text-truncate d-block">
                                        {{ row.user.email }} ·
                                        {% if row.user.password %}
                                            {{ row.opened }} / {{ feedLength }} ouverte{{ row.opened > 1 ? 's' : '' }}
                                        {% else %}
                                            compte pas encore activé
                                        {% endif %}
                                    </small>
                                </div>
                            </div>

                            {% if row.opened > 0 %}
                                <form method="post" action="{{ path('app_admin_recipient_reset', {id: row.user.id}) }}"
                                      onsubmit="return confirm('Remettre {{ row.user.publicName }} au début du fil ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reset_recipient_' ~ row.user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary flex-shrink-0">Remettre au début</button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="col-12 col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 card-title mb-3">Inviter quelqu'un</h2>
                    <p class="form-text mt-0 mb-3">Une adresse déjà invitée mais pas encore activée reçoit un lien neuf, et son prénom ou son avatar sont mis à jour.</p>

                    {{ form_start(form) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.displayName) }}

                        <div class="mb-3">
                            {{ form_label(form.avatar) }}
                            {# Le radio est écrit à la main : le thème Bootstrap
                               l'envelopperait dans un form-check avec son propre
                               label, qui doublerait le nom et casserait la grille. #}
                            <div class="avatar-grid">
                                {% for choice in form.avatar %}
                                    <input type="radio"
                                           class="visually-hidden"
                                           id="{{ choice.vars.id }}"
                                           name="{{ choice.vars.full_name }}"
                                           value="{{ choice.vars.value }}"
                                           {{ choice.vars.checked ? 'checked' : '' }}>
                                    <label class="avatar-choice" for="{{ choice.vars.id }}">
                                        <span class="avatar-choice-emoji" aria-hidden="true">{{ choice.vars.value }}</span>
                                        <span class="avatar-choice-name">{{ choice.vars.label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                            {{ form_errors(form.avatar) }}

                            {# Les radios sont écrits à la main plus haut : sans
                               ce passage, form_end() les rendrait une seconde
                               fois, en liste, sous le bouton d'envoi. #}
                            {% do form.avatar.setRendered %}
                        </div>

                        <button type="submit" class="btn btn-primary mt-2">Envoyer l'invitation</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
