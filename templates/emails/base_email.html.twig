<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block subject %}{% endblock %}</title>
    </head>
    <body style="margin: 0; padding: 24px; background-color: #f5f5f5; font-family: Helvetica, Arial, sans-serif; color: #212529;">
        <table role="presentation" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 8px;">
            <tr>
                <td style="padding: 32px;">
                    {% block content %}{% endblock %}
                </td>
            </tr>
        </table>
    </body>
</html>
