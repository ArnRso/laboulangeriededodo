{% extends 'emails/base_email.html.twig' %}

{% block subject %}Votre accès à l'administration{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 16px; font-size: 22px;">Bienvenue dans l'administration</h1>

    <p style="margin: 0 0 16px; line-height: 1.5;">
        Un accès administrateur vient d'être créé pour <strong>{{ user.email }}</strong>.
        Il ne reste qu'à choisir un mot de passe pour l'activer.
    </p>

    <p style="margin: 0 0 24px;">
        <a href="{{ invitationUrl }}" style="display: inline-block; padding: 12px 24px; background-color: #0d6efd; color: #ffffff; text-decoration: none; border-radius: 6px;">
            Définir mon mot de passe
        </a>
    </p>

    <p style="margin: 0; font-size: 14px; color: #6c757d; line-height: 1.5;">
        Ce lien est valable {{ expirationDays }} jours. Passé ce délai, il faudra en demander un nouveau.
    </p>
{% endblock %}
