<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}La Boulangerie de Dodo{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎁</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% block header %}
            {% set route = app.request.attributes.get('_route') %}

            <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                        <i class="bi bi-gift" aria-hidden="true"></i>
                        La Boulangerie de Dodo
                    </a>

                    {% if app.user %}
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                data-bs-target="#navbarMain" aria-controls="navbarMain"
                                aria-expanded="false" aria-label="Afficher la navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarMain">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link{{ route starts with 'app_admin_pack' or route starts with 'app_admin_media' ? ' active' : '' }}"
                                           href="{{ path('app_admin_pack_index') }}">
                                            <i class="bi bi-collection me-1" aria-hidden="true"></i>Packs
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link{{ route == 'app_admin_recipient' ? ' active' : '' }}"
                                           href="{{ path('app_admin_recipient') }}">
                                            <i class="bi bi-person-heart me-1" aria-hidden="true"></i>Destinataire
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="nav-item">
                                        <a class="nav-link{{ route starts with 'app_journey' ? ' active' : '' }}"
                                           href="{{ path('app_journey') }}">
                                            <i class="bi bi-stars me-1" aria-hidden="true"></i>Mes souvenirs
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>

                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                                        <span class="text-truncate" style="max-width: 14rem;">{{ app.user.email }}</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <li>
                                                <a class="dropdown-item{{ route == 'app_admin_account' ? ' active' : '' }}"
                                                   href="{{ path('app_admin_account') }}">
                                                    <i class="bi bi-key me-2" aria-hidden="true"></i>Mon compte
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                        {% endif %}
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_logout') }}">
                                                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Déconnexion
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </nav>
        {% endblock %}

        <main class="container flex-grow-1 py-4">
            {% block flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
