<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}La Boulangerie de Dodo{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎁</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% block header %}
            <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">La Boulangerie de Dodo</a>
                    {% if app.user %}
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-body-secondary small">{{ app.user.email }}</span>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_logout') }}">Déconnexion</a>
                        </div>
                    {% endif %}
                </div>
            </nav>
        {% endblock %}

        <main class="container flex-grow-1 py-4">
            {% block flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
