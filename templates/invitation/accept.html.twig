{% extends 'base.html.twig' %}

{% block title %}Choisir un mot de passe{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-2">Choisissez votre mot de passe</h1>
            <p class="text-body-secondary mb-4">Votre compte : {{ user.email }}</p>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.plainPassword.first) }}
                    {{ include('components/_password_field.html.twig', {field: form.plainPassword.first}, with_context: false) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword.second) }}
                    {{ include('components/_password_field.html.twig', {field: form.plainPassword.second}, with_context: false) }}
                </div>

                <button type="submit" class="btn btn-primary w-100">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
