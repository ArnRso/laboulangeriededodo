{% extends 'base_feed.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body_class %}f-body-lock{% endblock %}

{# Pas de bandeau sur l'écran verrouillé. #}
{% block flashes %}{% endblock %}

{% block body %}
    <main class="f-wrap" data-controller="clock cheat-code">
        <header class="f-clock">
            {# Comme sur un écran verrouillé : la date coiffe l'heure. #}
            <div class="f-clock-date" data-clock-target="date">{{ dateLabel }}</div>
            {# Coup de pouce de démonstration : « dodo » au clavier, ou l'horloge
               gardée appuyée deux secondes sur mobile. #}
            <div class="f-clock-time"
                 data-clock-target="time"
                 data-action="pointerdown->cheat-code#holdStart pointerup->cheat-code#holdEnd pointerleave->cheat-code#holdEnd pointercancel->cheat-code#holdEnd contextmenu->cheat-code#holdEnd">{{ now|date('H:i') }}</div>
        </header>

        {% if overview.next %}
            {# Hors de Turbo : il retire le cookie du double envoi après la
               soumission, ce qui ferait rejeter le jeton au coup suivant. #}
            <form class="f-cheat" method="post" action="{{ path('app_feed_skip') }}" data-turbo="false" data-cheat-code-target="form">
                <input type="hidden" name="_token" value="{{ csrf_token('feed_skip') }}">
            </form>
            <div class="f-cheat-hint" data-cheat-code-target="hint" aria-hidden="true">⏩ le temps saute…</div>
        {% endif %}

        {% if overview.isEmpty %}
            <div class="f-grp">Rien pour l'instant</div>
            <div class="f-n f-n-static">
                <span class="f-app f-app-plain">📭</span>
                <span class="f-b">
                    <span class="f-t">Aucune notification</span>
                    <span class="f-m">Le fil se remplit bientôt. Repasse un peu plus tard.</span>
                </span>
            </div>
        {% else %}
            {% if overview.fresh %}
                <div class="f-grp">Nouveau</div>
                {{ include('feed/_card.html.twig', {state: overview.fresh, variant: 'fresh'}, with_context: false) }}
            {% endif %}

            {% if overview.next %}
                <div class="f-grp">À venir</div>

                {{ include('feed/_locked.html.twig', {state: overview.next}, with_context: false) }}

            {% elseif overview.isFinished %}
                <div class="f-grp">Fin de saison</div>
                <div class="f-n f-n-static">
                    <span class="f-app f-app-plain">🏁</span>
                    <span class="f-b">
                        <span class="f-t">Plus rien ne devait arriver.</span>
                        <span class="f-m">Tu as tout vu. Tu peux relire, ou faire semblant de ne pas avoir compris.</span>
                    </span>
                </div>
            {% endif %}

            {% if overview.seen is not empty %}
                <div class="f-grp">Déjà consultées <span>{{ overview.seen|length }}</span></div>

                <div data-controller="stack">
                    {% for state in overview.seen %}
                        {{ include('feed/_card.html.twig', {state: state, variant: 'seen', hidden: loop.index > 2}, with_context: false) }}
                    {% endfor %}

                    {% if overview.seen|length > 2 %}
                        <button type="button" class="f-stack" data-stack-target="button" data-action="stack#reveal">
                            <span class="f-stack-icons">
                                {% for state in overview.seen|slice(2, 4) %}
                                    {{ include('feed/_app_icon.html.twig', {app: state.media.appKind, class: 'f-stack-icon'}, with_context: false) }}
                                {% endfor %}
                            </span>
                            <span class="f-stack-text">
                                <b>{{ overview.seen|length - 2 }} autre{{ overview.seen|length - 2 > 1 ? 's' : '' }} notification{{ overview.seen|length - 2 > 1 ? 's' : '' }}</b>
                                <small>Afficher ▾</small>
                            </span>
                        </button>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </main>
{% endblock %}
