{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}
{% set counterparty = data.counterparty|default('le.pot.agé') %}
{% set label = data.label|default('') ?: media.title %}
{% set statusLabel = data.statusLabel|default('Terminé') %}
{% set heroStatus = data.heroStatus|default('') ?: statusLabel %}
{% set note = data.note|default('') ?: media.description %}

{% block title %}{{ media.title }} · Revolut{% endblock %}
{% block body_class %}f-open f-open-rv{% endblock %}

{% block body %}
    <main class="f-wrap f-wrap-open">
        <div class="f-bar">
            {{ include('feed/_back.html.twig', {}, with_context: false) }}
            <b>Transaction</b>
            <span class="f-bar-spacer"></span>
        </div>

        <header class="rv-hero">
            <span class="rv-av">{{ counterparty|first|upper }}</span>
            <h1 class="rv-title">{{ label }}</h1>
            <p class="rv-sub">{{ counterparty }} · {{ heroStatus }}</p>
        </header>

        <section class="rv-card">
            <div class="rv-row"><span class="rv-ic">🗓</span><span>Date</span><b>{{ 'now'|date('d/m/Y') }}, {{ 'now'|date('H:i') }}</b></div>
            <div class="rv-row"><span class="rv-ic">🗂</span><span>Catégorie</span><b>{{ data.category|default('Décisions') }}</b></div>
            <div class="rv-row"><span class="rv-ic">💳</span><span>Carte</span><b>•••• {{ data.cardLast4|default('2015') }}</b></div>
            <div class="rv-row"><span class="rv-ic">🧾</span><span>Référence</span><b class="rv-ref">{{ data.reference|default('CB 2015 SOIRÉE DONT ON NE PARLE PLUS') }}</b></div>
            <div class="rv-row"><span class="rv-ic">✨</span><span>Statut</span><b>{{ statusLabel }}</b></div>
        </section>

        <h2 class="rv-h2">Reçu</h2>
        <section class="rv-card rv-card-media">
            {{ include('feed/_media.html.twig', {media: media, class: 'rv-media'}, with_context: false) }}
        </section>

        {% if note %}
            <h2 class="rv-h2">Note</h2>
            <section class="rv-card"><p class="rv-note">{{ note }}</p></section>
        {% endif %}

        <div class="rv-acts" aria-hidden="true">
            <span class="rv-act"><i>↗</i>Partager</span>
            <span class="rv-act"><i>⚑</i>Signaler un problème</span>
        </div>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
