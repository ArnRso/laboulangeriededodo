{% extends 'base_feed.html.twig' %}

{% import _self as yt %}

{% macro short(n) %}
    {%- set n = n|default(0) -%}
    {%- if n >= 1000000 -%}
        {{ (n / 1000000)|number_format(1, ',', ' ')|replace({',0': ''}) }} M
    {%- elseif n >= 1000 -%}
        {{ (n / 1000)|number_format(1, ',', ' ')|replace({',0': ''}) }} k
    {%- else -%}
        {{ n }}
    {%- endif -%}
{% endmacro %}

{% set data = media.appData %}
{% set channel = data.channel|default('Dodo du passé') %}
{% set avatar = recipient and recipient.avatar ? recipient.avatar.value : '🦤' %}

{% block title %}{{ media.title }} · YouTube{% endblock %}
{% block body_class %}f-open f-open-yt{% endblock %}

{% block body %}
    {{ include('feed/_aura_toast.html.twig', {media: media, justOpened: justOpened}, with_context: false) }}

    <main class="f-wrap f-wrap-open">
        <div class="f-bar">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <b class="yt-logo"><i>▶</i>YouTube</b>
            <span class="f-bar-spacer"></span>
        </div>

        <div class="yt-player">
            {{ include('feed/_media.html.twig', {media: media, class: 'yt-media'}, with_context: false) }}
            <span class="yt-duration">{{ data.duration|default('4:12') }}</span>
            <div class="yt-controls" aria-hidden="true">
                <span class="yt-time">1:42 / {{ data.duration|default('4:12') }}</span>
                <span class="yt-progress"><i></i></span>
            </div>
        </div>

        <h1 class="yt-title">{{ media.title }}</h1>
        <div class="yt-meta">{{ data.views|default('1,2 M de vues') }} · il y a {{ data.uploadedAgo|default('11 ans') }}</div>

        <div class="yt-channel">
            <span class="yt-av">{{ avatar }}</span>
            <div>
                <b>{{ channel }}</b>
                <small>{{ data.subscribers|default('42 k abonnés') }}</small>
            </div>
            <span class="yt-sub">S'abonner</span>
        </div>

        <div class="yt-pills" aria-hidden="true">
            <span class="yt-pill yt-pill-likes"><b>👍 {{ yt.short(data.likes) }}</b><i></i><b>👎</b></span>
            <span class="yt-pill">↗ Partager</span>
            <span class="yt-pill">⬇ Télécharger</span>
            <span class="yt-pill">✂ Clip</span>
        </div>

        <div class="yt-desc">
            <b>{{ data.views|default('1,2 M de vues') }} · il y a {{ data.uploadedAgo|default('11 ans') }}</b>
            {% if media.description %}<p>{{ media.description }}</p>{% endif %}
            <small>… plus</small>
        </div>

        <section class="yt-comments">
            <div class="yt-comments-head"><b>Commentaires</b><small>{{ yt.short((data.likes|default(0)) // 30) }}</small></div>

            <div class="yt-comment yt-comment-pinned">
                <small class="yt-pinned">📌 Épinglé par {{ channel }}</small>
                <div class="yt-comment-row">
                    <span class="yt-av yt-av-s">{{ avatar }}</span>
                    <div>
                        <small>@{{ channel|lower|replace({' ': '.'}) }} · il y a {{ data.uploadedAgo|default('11 ans') }}</small>
                        <p>
                            <b class="yt-aura {{ media.auraPoints < 0 ? 'yt-aura-neg' : '' }}">{{ media.auraPoints > 0 ? '+' : '' }}{{ media.auraPoints }} aura</b>
                            {{ media.auraMessage|default(media.auraPoints < 0 ? 'Cette décision était objectivement catastrophique.' : 'Ne la gaspille pas.') }}
                        </p>
                        <span class="yt-comment-acts" aria-hidden="true">👍 {{ yt.short((data.likes|default(0)) // 12) }} &nbsp; 👎 &nbsp; Répondre</span>
                    </div>
                </div>
            </div>

            <div class="yt-comment-add" aria-hidden="true">
                <span class="yt-av yt-av-s">{{ avatar }}</span>
                <span>Ajouter un commentaire…</span>
            </div>
        </section>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
