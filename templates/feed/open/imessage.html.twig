{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}
{% set contact = data.contact|default('Dodo du passé') %}

{% block title %}{{ media.title }} · iMessage{% endblock %}
{% block body_class %}f-open f-open-im{% endblock %}

{% block body %}
    {{ include('feed/_aura_toast.html.twig', {media: media, justOpened: justOpened}, with_context: false) }}

    <main class="f-wrap f-wrap-open">
        <div class="f-bar im-bar">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <div class="im-who">
                <span class="im-av">{{ data.contactEmoji|default('👶') }}</span>
                <b>{{ contact }} <i>›</i></b>
            </div>
            <span class="im-cam" aria-hidden="true">📹</span>
        </div>

        <div class="im-stamp"><b>iMessage</b><span>{{ data.statusLine|default('Il y a 11 ans, 23:41') }}</span></div>

        {{ include('feed/_chat.html.twig', {media: media, data: data, prefix: 'im', receipt: data.deliveredLabel|default('Distribué')}, with_context: false) }}

        <div class="im-input" aria-hidden="true">
            <span class="im-plus">＋</span>
            <div class="im-field"><span>iMessage</span><i>🎤</i></div>
        </div>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
