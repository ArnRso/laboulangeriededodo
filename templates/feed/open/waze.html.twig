{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}
{% set alerts = [] %}
{% for line in data.alerts|default('')|split('\n') %}
    {% if line|trim %}{% set alerts = alerts|merge([line|trim]) %}{% endif %}
{% endfor %}

{% block title %}{{ media.title }} · Waze{% endblock %}
{% block body_class %}f-open f-open-wz{% endblock %}

{% block body %}
    <main class="f-wrap f-wrap-open">
        <div class="f-bar f-bar-inverse">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <b>Itinéraire</b>
            <span class="f-bar-spacer"></span>
        </div>

        <div class="wz-map" aria-hidden="true">
            <i class="wz-road wz-road-1"></i>
            <i class="wz-road wz-road-2"></i>
            <i class="wz-road wz-road-3"></i>
            <i class="wz-route"></i>
            <span class="wz-bubble">
                <span class="wz-ghost"><i></i><i></i></span>
            </span>
            <span class="wz-flag">🏁</span>
        </div>

        <div class="wz-banner">
            <span class="wz-turn">⬆</span>
            <div>
                <b>Vers {{ data.destination|default('ton adolescence') }}</b>
                <small>{{ data.eta|default('4 min') }} · {{ data.distance|default('11 ans') }}</small>
            </div>
        </div>

        {% if alerts is not empty %}
            <div class="wz-alerts">
                {% for alert in alerts %}<span class="wz-alert">{{ alert }}</span>{% endfor %}
            </div>
        {% endif %}

        <section class="wz-card">
            <h2>Sur ta route</h2>
            <p class="wz-title">{{ data.routeTitle|default(media.title) }}</p>
            {{ include('feed/_media.html.twig', {media: media, class: 'wz-media'}, with_context: false) }}
        </section>

        {% set report = data.report|default(media.description) %}
        {% if report %}
            <section class="wz-card wz-report">
                <span class="wz-report-av">{{ recipient and recipient.avatar ? recipient.avatar.value : '🦤' }}</span>
                <div>
                    <small>Rapport d'un Wazer</small>
                    <p>{{ report }}</p>
                    <em>Signalé il y a longtemps · 👍 merci</em>
                </div>
            </section>
        {% endif %}

        <section class="wz-arrival">
            <div>
                <small>Arrivée</small>
                <b>{{ recipient ? recipient.publicName : 'Dodo' }} est arrivé·e</b>
            </div>
            <span class="wz-flag-end" aria-hidden="true">🏁</span>
        </section>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
