{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}

{% block title %}{{ media.title }} · Uber Eats{% endblock %}
{% block body_class %}f-open f-open-ue{% endblock %}

{% block body %}
    <main class="f-wrap f-wrap-open">
        <div class="f-bar">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <b>Détails de la commande</b>
            <span class="f-bar-spacer"></span>
        </div>

        <header class="ue-hero">
            <div class="ue-status"><i>✓</i>Commande livrée</div>
            <h1>{{ data.orderTitle|default(media.title) }}</h1>
            <p>Commande n° {{ media.position + 1 }} · livrée par {{ data.courier|default('Dodo du passé') }}</p>
        </header>

        <div class="ue-map" aria-hidden="true">
            <span class="ue-map-a">{{ recipient and recipient.avatar ? recipient.avatar.value : '🦤' }}</span>
            <span class="ue-map-z">🎁</span>
            <small>{{ data.trip|default('Ton adolescence → Aujourd\'hui') }}</small>
        </div>

        <section class="ue-sec">
            <h2>Ta commande</h2>
            <div class="ue-item">
                <span class="ue-qty">1×</span>
                <div class="ue-item-body">
                    <b>{{ data.itemName|default(media.title) }}</b>
                    {% set itemNote = data.itemNote|default(media.description) %}
                    {% if itemNote %}<p>{{ itemNote }}</p>{% endif %}
                </div>
            </div>

            {{ include('feed/_media.html.twig', {media: media, class: 'ue-media'}, with_context: false) }}
        </section>

        <section class="ue-rate">
            <small>Note ta commande</small>
            {% set stars = data.stars|default(5) %}
            <div class="ue-stars" aria-label="{{ stars }} étoiles sur 5">
                {% for i in 1..5 %}<span class="{{ i <= stars ? 'on' : '' }}">★</span>{% endfor %}
            </div>
        </section>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
