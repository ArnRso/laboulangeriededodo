{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}
{% set counterparty = data.counterparty|default('Dodo du passé') %}
{% set email = counterparty|lower|replace({' ': '.', '\'': '', é: 'e', è: 'e', ê: 'e', à: 'a', ç: 'c', ô: 'o', î: 'i', ï: 'i', ù: 'u', û: 'u'}) ~ '@passe.fr' %}

{% block title %}{{ media.title }} · PayPal{% endblock %}
{% block body_class %}f-open f-open-pp{% endblock %}

{% block body %}
    <main class="f-wrap f-wrap-open">
        <div class="f-bar f-bar-line">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <b class="pp-logo" aria-label="PayPal"><span>Pay</span><span>Pal</span></b>
            <span class="f-bar-spacer"></span>
        </div>

        <header class="pp-hero">
            <span class="pp-check">✓</span>
            <p class="pp-kicker">Tu as reçu un paiement</p>
            <h1 class="pp-title">{{ media.title }}</h1>
            <small class="pp-date">{{ 'now'|date('d/m/Y') }} · {{ 'now'|date('H:i') }}</small>
        </header>

        <section class="pp-card pp-sender">
            <span class="pp-av">{{ counterparty|first|upper }}</span>
            <div>
                <small>Envoyé par</small>
                <b>{{ counterparty }}</b>
                <span class="pp-mail">{{ email }}</span>
            </div>
        </section>

        {% if data.note|default('') %}
            <section class="pp-card pp-note">
                <small>Note</small>
                <p>« {{ data.note }} »</p>
            </section>
        {% endif %}

        <h2 class="pp-h2">Pièce jointe</h2>
        <section class="pp-card pp-card-media">
            {{ include('feed/_media.html.twig', {media: media, class: 'pp-media'}, with_context: false) }}
        </section>

        {% if media.description %}
            <h2 class="pp-h2">Détails</h2>
            <section class="pp-card"><p class="pp-details">{{ media.description }}</p></section>
        {% endif %}

        <div class="pp-btns" aria-hidden="true">
            <span class="pp-btn">Transférer vers mon compte</span>
            <span class="pp-btn pp-btn-s">Envoyer un remerciement</span>
        </div>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
