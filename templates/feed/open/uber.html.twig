{% extends 'base_feed.html.twig' %}

{% set data = media.appData %}
{% set driver = data.driver|default('Dodo du passé') %}
{% set rating = data.rating|default(5) %}

{% block title %}{{ media.title }} · Uber{% endblock %}
{% block body_class %}f-open f-open-ub{% endblock %}

{% block body %}
    {{ include('feed/_aura_toast.html.twig', {media: media, justOpened: justOpened}, with_context: false) }}

    <main class="f-wrap f-wrap-open">
        <div class="f-bar">
            <a class="f-back" href="{{ path('app_feed') }}" aria-label="Retour">‹</a>
            <b>Reçu de course</b>
            <span class="f-bar-spacer"></span>
        </div>

        <div class="ub-map" aria-hidden="true">
            <i class="ub-road ub-road-1"></i>
            <i class="ub-road ub-road-2"></i>
            <i class="ub-road ub-road-3"></i>
            <svg class="ub-path" viewBox="0 0 100 60" preserveAspectRatio="none">
                <path d="M14 44 C 30 44, 34 16, 52 16 S 76 30, 86 16" />
            </svg>
            <span class="ub-pin ub-pin-a"></span>
            <span class="ub-pin ub-pin-z"></span>
            <span class="ub-car">🚗</span>
        </div>

        <header class="ub-hero">
            <div class="ub-done">Course terminée</div>
            <h1>{{ media.title }}</h1>
            <p>{{ 'now'|date('d/m/Y') }} · {{ data.duration|default('11 ans') }} de trajet</p>
        </header>

        <section class="ub-trip">
            <div class="ub-stop">
                <span class="ub-stop-dot"></span>
                <div>
                    <b>{{ data.fromPlace|default('Ton adolescence') }}</b>
                    <small>Départ · {{ 'now'|date_modify('-23 minutes')|date('H:i') }}</small>
                </div>
            </div>
            <div class="ub-stop">
                <span class="ub-stop-dot ub-stop-sq"></span>
                <div>
                    <b>{{ data.toPlace|default('Aujourd\'hui') }}</b>
                    <small>Arrivée · {{ 'now'|date('H:i') }}</small>
                </div>
            </div>
        </section>

        <section class="ub-driver">
            <span class="ub-av">{{ recipient and recipient.avatar ? recipient.avatar.value : '🦤' }}</span>
            <div class="ub-driver-body">
                <b>{{ driver }}</b>
                <small>{{ data.car|default('Peugeot 206 · AB-123-CD') }}</small>
                <div class="ub-stars" aria-label="{{ rating }} étoiles sur 5">
                    {% for i in 1..5 %}<span class="{{ i <= rating ? 'on' : '' }}">★</span>{% endfor %}
                    <small>Ta note</small>
                </div>
            </div>
        </section>

        <section class="ub-lost">
            <h2>Objet oublié dans la voiture</h2>
            {{ include('feed/_media.html.twig', {media: media, class: 'ub-media'}, with_context: false) }}
            {% if media.description %}
                <div class="ub-note">
                    <small>Note de trajet</small>
                    <p>{{ media.description }}</p>
                </div>
            {% endif %}
        </section>

        <section class="ub-receipt">
            <h2>Reçu</h2>
            <div class="ub-row"><span>Course</span><span>{{ media.auraPoints > 0 ? '+' : '' }}{{ media.auraPoints }} aura</span></div>
            <div class="ub-row"><span>Frais de réservation</span><span>0 aura</span></div>
            <div class="ub-row"><span>Pourboire à {{ driver }}</span><span>0 aura (il le méritait pourtant)</span></div>
            <div class="ub-row ub-row-total"><span>Total</span><span class="{{ media.auraPoints < 0 ? 'ub-neg' : '' }}">{{ media.auraPoints > 0 ? '+' : '' }}{{ media.auraPoints }} aura</span></div>
            <small class="ub-pay">Payé avec ton aura · Aucun remboursement possible, c'est du passé</small>
        </section>
    </main>

    {% if not preview %}
        <div class="f-cta"><a href="{{ path('app_feed') }}">Retour aux notifications</a></div>
    {% endif %}
{% endblock %}
