{#
    Une notification dans le fil, habillée aux couleurs de son application.

    Paramètres :
      - state   : NotificationState
      - variant : 'fresh' (arrivée, non lue) ou 'seen' (déjà consultée)
      - hidden  : replié dans la pile (optionnel)
#}
{% set media = state.media %}
{% set app = media.appKind %}

<a class="f-n f-n-{{ app.value }} f-n-{{ variant }}"
   href="{{ path('app_feed_open', {id: media.id}) }}"
   {{ hidden|default(false) ? 'hidden' : '' }}>
    {% if variant == 'fresh' %}<span class="f-dot" aria-hidden="true"></span>{% endif %}

    {{ include('feed/_app_icon.html.twig', {app: app}, with_context: false) }}

    <span class="f-b">
        <span class="f-h">
            <b>{{ app.label }}</b>
            <small>{% if variant == 'fresh' %}maintenant{% else %}✓ {{ state.openedAt|date('d/m') }}{% endif %}</small>
        </span>

        {% if variant == 'fresh' %}
            {# Rien du contenu ne sort d'ici : l'écran verrouillé annonce
               qu'une notification est arrivée, pas ce qu'elle dit. #}
            <span class="f-t f-t-hidden">Notification masquée</span>
            <span class="f-btn">{{ app.openLabel }}</span>
        {% else %}
            <span class="f-t">{{ media.title }}</span>
            {% if media.description %}
                <span class="f-m f-m-clip">{{ media.description }}</span>
            {% endif %}
        {% endif %}
    </span>

</a>
