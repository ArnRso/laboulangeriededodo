<div class="mt-5">
    <h2 class="h5 mb-3">Collections terminées</h2>

    <div class="list-group">
        {% for progress in completed %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               href="{{ path('app_journey_pack_history', {id: progress.pack.id}) }}">
                <span>{{ progress.pack.name }}</span>
                <span class="badge text-bg-secondary">{{ progress.pack.mediaCount }}</span>
            </a>
        {% endfor %}
    </div>
</div>
