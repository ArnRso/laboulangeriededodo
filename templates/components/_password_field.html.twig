{#
    Champ mot de passe avec bouton d'affichage.

    Paramètres :
      - field : le FormView du champ, rendu via form_widget
#}
<div data-controller="password-visibility">
    <div class="input-group{{ field.vars.valid ? '' : ' has-validation' }}">
        {# La classe form-control est déjà posée par le thème Bootstrap. #}
        {{ form_widget(field, {attr: field.vars.attr|merge({
            'data-password-visibility-target': 'input',
            class: field.vars.valid ? '' : 'is-invalid',
        })}) }}

        <button type="button"
                class="btn btn-outline-secondary"
                data-action="password-visibility#toggle"
                data-password-visibility-target="button"
                aria-label="Afficher le mot de passe"
                aria-pressed="false"
                tabindex="-1">
            <i class="bi bi-eye" data-password-visibility-target="icon" aria-hidden="true"></i>
        </button>

        {# Le message doit vivre dans l'input-group, sinon Bootstrap le masque. #}
        {% if not field.vars.valid %}
            <div class="invalid-feedback">
                {% for error in field.vars.errors %}
                    {{ error.message }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
