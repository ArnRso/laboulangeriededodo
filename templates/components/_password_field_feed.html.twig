{#
    Champ mot de passe du fil, avec bouton d'affichage.

    Paramètres :
      - field : le FormView du champ, rendu via form_widget
#}
<div class="f-field" data-controller="password-visibility">
    <div class="f-input-group{{ field.vars.valid ? '' : ' f-input-group-invalid' }}">
        {{ form_widget(field, {attr: field.vars.attr|merge({
            class: 'f-input',
            'data-password-visibility-target': 'input',
        })}) }}

        <button type="button"
                class="f-eye"
                data-action="password-visibility#toggle"
                data-password-visibility-target="button"
                aria-label="Afficher le mot de passe"
                aria-pressed="false"
                tabindex="-1">
            <span data-password-visibility-target="icon" data-show="👁" data-hide="🙈" aria-hidden="true">👁</span>
        </button>
    </div>

    {% if not field.vars.valid %}
        <div class="f-error">
            {% for error in field.vars.errors %}{{ error.message }} {% endfor %}
        </div>
    {% endif %}
</div>
