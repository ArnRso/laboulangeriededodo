# Configuration de production embarquée dans l'image Docker.
# Les vraies valeurs (APP_SECRET, DATABASE_URL, MAILER_DSN) sont fournies
# par l'environnement du conteneur sur le serveur.
APP_ENV=prod
APP_DEBUG=0

APP_SECRET=CHANGE_ME_IN_PRODUCTION

DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8"

# Les liens d'invitation sont générés hors requête HTTP : sans cette URL,
# ils pointeraient vers localhost et seraient inutilisables.
DEFAULT_URI=https://laboulangeriededodo.home-arnrso.com

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Remplacé au déploiement : smtps://<user>:<pass>@rosette.o2switch.net:465
MAILER_DSN=null://null
MAIL_SENDER_ADDRESS=laboulangeriededodo@home-arnrso.com
MAIL_SENDER_NAME="La Boulangerie de Dodo"

APP_SHARE_DIR=var/share

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
